<?xml version="1.0" encoding="UTF-8"?>
<configuration>
<system.webServer>
<rewrite>
<rules><rule name="R1" stopProcessing="true">
<match url="^1rm-calculator/?$" />
<action type="Redirect" url="https://onerepmaxcalculator.me/#tab=1rm" redirectType="Permanent" />
</rule><rule name="R2" stopProcessing="true">
<match url="^calories-burned-calculator/?$" />
<action type="Redirect" url="https://onerepmaxcalculator.me/" redirectType="Permanent" />
</rule><rule name="R3" stopProcessing="true">
<match url="^calorie-calculator/?$" />
<action type="Redirect" url="https://onerepmaxcalculator.me/" redirectType="Permanent" />
</rule><rule name="R4" stopProcessing="true">
<match url="^bmi-calculator/?$" />
<action type="Redirect" url="https://onerepmaxcalculator.me/" redirectType="Permanent" />
</rule><rule name="R5" stopProcessing="true">
<match url="^rpe-calculator/?$" />
<action type="Redirect" url="https://onerepmaxcalculator.me/" redirectType="Permanent" />
</rule><rule name="R6" stopProcessing="true">
<match url="^body-fat-calculator/?$" />
<action type="Redirect" url="https://onerepmaxcalculator.me/" redirectType="Permanent" />
</rule><rule name="R7" stopProcessing="true">
<match url="^training-tracker/?$" />
<action type="Redirect" url="https://onerepmaxcalculator.me/#tab=tracker" redirectType="Permanent" />
</rule><rule name="R8" stopProcessing="true">
<match url="^strength-level-calculator/?$" />
<action type="Redirect" url="https://onerepmaxcalculator.me/" redirectType="Permanent" />
</rule><rule name="R9" stopProcessing="true">
<match url="^heart-rate-zone-calculator/?$" />
<action type="Redirect" url="https://onerepmaxcalculator.me/" redirectType="Permanent" />
</rule><rule name="R10" stopProcessing="true">
<match url="^wilks-dots-calculator/?$" />
<action type="Redirect" url="https://onerepmaxcalculator.me/#tab=score" redirectType="Permanent" />
</rule><rule name="R11" stopProcessing="true">
<match url="^plate-calculator/?$" />
<action type="Redirect" url="https://onerepmaxcalculator.me/#tab=plate" redirectType="Permanent" />
</rule></rules>
</rewrite>
</system.webServer>
</configuration>